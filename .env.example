# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Get these from Supabase dashboard: https://app.supabase.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Frontend (public)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# BLAND AI CONFIGURATION
# ============================================
# Get from Bland AI dashboard: https://app.bland.ai
BLAND_AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxx
BLAND_WEBHOOK_URL=https://your-domain.vercel.app/api/bland-webhook
BLAND_WEBHOOK_SECRET=your-webhook-signing-secret

# ============================================
# DEPLOYMENT
# ============================================
# Backend API URL (for frontend to call)
PUBLIC_BACKEND_URL=https://your-backend-service.com
# or for development:
# PUBLIC_BACKEND_URL=http://localhost:8000

# ============================================
# ENVIRONMENT
# ============================================
NODE_ENV=development